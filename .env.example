# Copy this file to .env and replace the development password before starting PostgreSQL.
ITC_MEMORY_POSTGRES_DB=itc_memory
ITC_MEMORY_POSTGRES_USER=itc_memory
ITC_MEMORY_POSTGRES_PASSWORD=change-this-local-password
ITC_MEMORY_POSTGRES_HOST=127.0.0.1
ITC_MEMORY_POSTGRES_PORT=5432
# Optional allowlist override: one absolute exact Git checkout per line.
# Relative configuration file paths are resolved from this .env file's real directory.
# Parent folders containing multiple checkouts are rejected.
# ITC_MEMORY_INDEX_ROOTS_FILE=config/index-roots.txt
# Without either override the compiled local list is used, or the current checkout
# when no list existed at build time. Rebuild after changing the list.
# ITC_MEMORY_INDEX_ROOTS_FILE takes precedence over ITC_MEMORY_INDEX_ROOTS.
# Alternatively, use comma-separated exact checkout paths:
# ITC_MEMORY_INDEX_ROOTS=/path/to/repository-a,/path/to/repository-b
# Local, trusted-LAN, and hosted model providers; hosted credentials use named environment variables.
ITC_MEMORY_MODELS_FILE=config/models.json
# Required only for third-party hosted inference; trusted LAN providers are configured explicitly.
ITC_MEMORY_ALLOW_HOSTED=false
# HTTP is loopback-only and requires a generated bearer token.
# ITC_MEMORY_MCP_BIND=127.0.0.1:8765
# ITC_MEMORY_MCP_TOKEN=
